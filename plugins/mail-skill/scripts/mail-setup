#!/usr/bin/env bash
# mailskill setup — 회사메일(NAVER WORKS) 1회 설정. bash 판(scripts/mail-setup.ps1 과 같은 계약).
#   1) age 키 보장(없으면 생성) + recipients.txt 에 이 기계 공개키
#   2) 앱 비밀번호를 숨김 입력 → secret-set 으로 himalaya-<acct>-imap / -smtp 두 이름에 저장
#   3) 템플릿(config/works.template.toml)으로 이 PC 전용 himalaya config 생성
#   4) himalaya account doctor 로 auth.cmd → age 복호 → IMAP/SMTP 로그인 확인
#
#   mailskill setup [--email <주소>] [--login <아이디>] [--display-name <이름>]
#                   [--account <이름>] [--password-stdin] [--no-verify]
#
# 비밀번호는 인자로 받지 않는다. 화면·로그·평문 파일에 남기지 않는다(age 암호화 저장만).
# 런타임(himalaya·age)은 설치하지 않는다 — 없으면 무엇이 없는지만 알린다(TS-RUNTIME-2).
# exit: 0 완료 · 1 환경 문제(런타임·키·설정) · 2 사용법 · 3 저장은 됐으나 로그인 확인 실패
set -euo pipefail
_self="$0"; while [ -L "$_self" ]; do _t="$(readlink "$_self")"; case "$_t" in /*) _self="$_t";; *) _self="$(dirname "$_self")/$_t";; esac; done
REPO="${MAIL_SKILL_REPO:-$(cd "$(dirname "$_self")/.." && pwd)}"
H="${HIMALAYA_BIN:-himalaya}"

say()  { printf '%s\n' "$*" >&2; }
fail() { say "✗ $1"; [ -n "${2:-}" ] && say "  → $2"; exit "${3:-1}"; }

# 사용법은 이 파일 머리 주석에서 뽑는다 — 두 군데에 적어두면 갈라진다.
usage() { sed -n '2,/^set -euo/p' "$_self" | sed '$d' | sed 's/^# \{0,1\}//'; }

acct="ji"; email=""; login=""; dname=""; pwstdin=0; verify=1
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)        usage; exit 0 ;;
    --email)          email="${2:?--email 값}"; shift 2 ;;
    --login)          login="${2:?--login 값}"; shift 2 ;;
    --display-name)   dname="${2:?--display-name 값}"; shift 2 ;;
    --account)        acct="${2:?--account 값}"; shift 2 ;;
    --password-stdin) pwstdin=1; shift ;;
    --no-verify)      verify=0; shift ;;
    *) say "mailskill setup: 알 수 없는 옵션 '$1'"; usage >&2; exit 2 ;;
  esac
done
[[ "$acct" =~ ^[a-z0-9][a-z0-9-]*$ ]] || fail "계정 이름은 영문 소문자·숫자·- 만: '$acct'" "" 2

# ── 0) 런타임 탐지(설치는 하지 않음) ─────────────────────────────────────────
missing=()
for t in "$H" age age-keygen; do command -v "$t" >/dev/null 2>&1 || missing+=("$t"); done
[ ${#missing[@]} -eq 0 ] || fail "필요한 프로그램이 없습니다: ${missing[*]}" "jaix setup 이 설치합니다. jaix setup 을 먼저 실행한 뒤 다시 하세요."

# 비밀번호는 사람이 직접 터미널에서 넣는다. 에이전트 도구처럼 터미널이 없는 곳에서는
# 숨김 입력이 불가능하므로 시작 전에 멈춘다(--password-stdin 은 자동화·테스트용).
if [ "$pwstdin" = 0 ] && ! [ -t 0 ]; then
  fail "이 명령은 직접 연 터미널에서 실행해야 합니다(비밀번호를 숨김 입력으로 받기 때문)." \
       "터미널 창을 열고 'mailskill setup' 을 입력하세요." 2
fi
if [ "$pwstdin" = 1 ] && [ -z "$email" ]; then
  fail "--password-stdin 을 쓰면 --email 도 함께 주어야 합니다." "" 2
fi

# ── 경로(리졸버 mail-secret / secret-set 과 같은 규칙) ───────────────────────
KEY="${MAIL_SKILL_AGE_KEY:-$HOME/.config/mail-skill/age-key.txt}"
if [ -n "${MAIL_SKILL_SECRETS:-}" ]; then SECRETS="$MAIL_SKILL_SECRETS"; repo_mode=0
elif [ -f "$REPO/secrets/recipients.txt" ]; then SECRETS="$REPO/secrets/secrets.age"; repo_mode=1
else SECRETS="$HOME/.config/mail-skill/secrets.age"; repo_mode=0; fi
RECIP="$(dirname "$SECRETS")/recipients.txt"
CONF="${HIMALAYA_CONFIG:-$HOME/.config/himalaya/config.toml}"
TPL="$REPO/config/works.template.toml"
[ -f "$TPL" ] || fail "템플릿이 없습니다: $TPL" "mail-skill 을 다시 설치하세요(jaix setup)."

# ── 1) 이메일·로그인 ─────────────────────────────────────────────────────────
if [ -z "$email" ]; then
  printf '회사 메일 주소: ' >&2; IFS= read -r email || true
fi
email="$(printf '%s' "$email" | tr -d '[:space:]')"
[[ "$email" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] \
  || fail "메일 주소 형식이 아닙니다: '$email'" "예: hong@example.com 처럼 전체 주소를 넣으세요." 2
login="${login:-$email}"
[[ "$login" =~ ^[A-Za-z0-9._%+@-]+$ ]] || fail "로그인 아이디에 쓸 수 없는 문자가 있습니다: '$login'" "" 2
dname="${dname:-$email}"
dname="${dname//\"/}"; dname="${dname//\\/}"   # TOML 문자열을 깨는 문자 제거

# ── 2) age 키 + recipients ──────────────────────────────────────────────────
mkdir -p "$(dirname "$KEY")" "$(dirname "$SECRETS")"
newkey=0
if [ ! -f "$KEY" ]; then
  ( umask 077; age-keygen -o "$KEY" 2>/dev/null ) || fail "age 키를 만들지 못했습니다: $KEY" "폴더 쓰기 권한을 확인하세요."
  newkey=1; say "✓ 이 PC 전용 암호화 키를 만들었습니다: $KEY"
fi
PUB="$(age-keygen -y "$KEY")" || fail "age 키를 읽지 못했습니다: $KEY" "파일이 손상됐다면 지우고 다시 실행하세요."

if [ "$repo_mode" = 1 ]; then
  # 개발용 저장소 모드: recipients 는 여러 기계가 공유하므로 건드리지 않는다.
  grep -qxF "$PUB" "$RECIP" || fail "이 기계 공개키가 $RECIP 에 없습니다." "등록된 기계에서 공개키를 추가·재암호화(secret-edit)한 뒤 다시 실행하세요."
else
  # 1인 1기계: 이 기계 키로 열 수 없는 기존 secrets.age 는 쓸모가 없다 → 치워 두고 새로 시작.
  if [ -f "$SECRETS" ] && { [ "$newkey" = 1 ] || ! age -d -i "$KEY" "$SECRETS" >/dev/null 2>&1; }; then
    bak="$SECRETS.bak-$(date +%Y%m%d%H%M%S)"; mv "$SECRETS" "$bak"
    say "! 이 키로 열 수 없는 기존 비밀 파일을 옮겨 두었습니다: $bak"
  fi
  # 비밀 파일이 아직 없으면(처음 설정) recipient 는 이 기계 하나뿐이다.
  [ -f "$SECRETS" ] || printf '%s\n' "$PUB" > "$RECIP"
  grep -qxF "$PUB" "$RECIP" 2>/dev/null || printf '%s\n' "$PUB" >> "$RECIP"
fi

# ── 3) 앱 비밀번호(숨김 입력) → age 암호화 저장 ─────────────────────────────
if [ "$pwstdin" = 1 ]; then
  IFS= read -r pw || true
else
  . "$(dirname "$_self")/read-masked.sh"
  read_masked 'NAVER WORKS 앱 비밀번호(글자마다 * 로 표시됩니다): '
  pw="$MASKED"; MASKED=""
fi
pw="${pw%$'\r'}"
pw="$(printf '%s' "$pw" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
[ -n "$pw" ] || fail "비밀번호가 비어 있습니다." "발급 방법: $REPO/docs/naver-works-app-password.md" 2

export MAIL_SKILL_AGE_KEY="$KEY" MAIL_SKILL_SECRETS="$SECRETS"
for kind in imap smtp; do
  printf '%s\n' "$pw" | "$REPO/scripts/secret-set" "himalaya-$acct-$kind" --stdin \
    || { pw=""; fail "비밀번호 저장에 실패했습니다(himalaya-$acct-$kind)." "age 가 동작하는지 확인하고 다시 실행하세요."; }
done
pw=""
say "✓ 앱 비밀번호를 암호화해 저장했습니다: $SECRETS"

# ── 4) 이 PC 전용 himalaya 설정 ─────────────────────────────────────────────
# 치환 문자열을 따옴표로 감싸는 방식은 bash 3.2(맥 기본)에서 따옴표가 그대로 남는다.
# 대신 bash 5.2+ 의 '&' 특수의미(patsub_replacement)를 끄고 맨 치환을 쓴다.
shopt -u patsub_replacement 2>/dev/null || true
render() {
  local t; t="$(cat "$TPL")"
  t="${t//__ACCOUNT__/$acct}"; t="${t//__EMAIL__/$email}"
  t="${t//__LOGIN__/$login}";  t="${t//__DISPLAY_NAME__/$dname}"
  # 템플릿 머리 주석은 버리고(자리표시 설명이라) 이 파일의 출처만 한 줄 남긴다.
  printf '# mailskill setup 이 만든 이 PC 전용 설정(%s) — 공유·커밋하지 마세요.\n' "$(date +%Y-%m-%d)"
  printf '%s\n' "$t" | sed -n '/^\[accounts\./,$p'
}
mkdir -p "$(dirname "$CONF")"
if [ -L "$CONF" ]; then
  # 심링크는 대개 저장소의 공용 설정을 가리킨다 — 남의 파일을 고치지 않는다.
  if grep -q "^\[accounts\.$acct\]" "$CONF" 2>/dev/null; then say "✓ 기존 설정을 그대로 씁니다: $CONF"
  else fail "$CONF 가 다른 파일을 가리키는 링크라 고치지 않았습니다." "그 파일에 [accounts.$acct] 블록을 직접 넣거나 링크를 지운 뒤 다시 실행하세요."; fi
elif [ ! -e "$CONF" ]; then
  ( umask 077; render > "$CONF" ); say "✓ 메일 설정을 만들었습니다: $CONF"
elif grep -q "^\[accounts\.$acct\]" "$CONF"; then
  say "✓ 기존 설정에 '$acct' 계정이 있어 그대로 씁니다: $CONF"
else
  cp -p "$CONF" "$CONF.bak-$(date +%Y%m%d%H%M%S)"
  { printf '\n'; render | grep -v '^default = true$'; } >> "$CONF"
  say "✓ 기존 설정 끝에 '$acct' 계정을 덧붙였습니다(백업 .bak-*): $CONF"
fi

# ── 5) 확인: auth.cmd → age 복호 → IMAP/SMTP 로그인 ─────────────────────────
[ "$verify" = 1 ] || { say "· 로그인 확인은 건너뛰었습니다(--no-verify). 나중에: mailskill doctor $acct"; exit 0; }
command -v mail-secret >/dev/null 2>&1 \
  || fail "mail-secret 명령을 찾을 수 없어 메일 프로그램이 비밀번호를 못 읽습니다." "jaix setup 을 다시 실행해 PATH 를 잡은 뒤 'mailskill doctor $acct' 로 확인하세요." 3
out="$(NO_COLOR=1 RUST_LOG=off "$H" account doctor "$acct" 2>&1)" && rc=0 || rc=$?
if [ "$rc" = 0 ]; then
  say "✓ 로그인 확인 완료 — 이제 '$acct' 계정으로 메일을 읽고 보낼 수 있습니다."
  exit 0
fi
printf '%s\n' "$out" | sed 's/\x1b\[[0-9;]*m//g' | grep -vE '^\s*$|^Note' | tail -4 | sed 's/^/    /' >&2
if printf '%s' "$out" | grep -qi 'authentication failed'; then
  fail "로그인 실패 — 아이디 또는 앱 비밀번호가 틀렸습니다." "앱 비밀번호를 새로 발급해 'mailskill setup' 을 다시 실행하세요($REPO/docs/naver-works-app-password.md)." 3
elif printf '%s' "$out" | grep -qiE 'mail-secret|cannot (run|execute)|not found|password'; then
  fail "메일 프로그램이 저장된 비밀번호를 읽지 못했습니다." "'mailskill doctor $acct' 로 다시 확인하고, 계속되면 관리자에게 위 내용을 보내세요." 3
else
  fail "메일 서버에 접속하지 못했습니다(네트워크 또는 IMAP/SMTP 사용 허용 여부)." "회사망·인터넷 연결을 확인하고, 계속되면 웍스 관리자에게 IMAP/SMTP 허용을 요청하세요." 3
fi
